#include <stdio.h>

int main() {
    float a, b, result;

    printf("Enter the first number: ");
    scanf("%f", &a);

    printf("Enter the second number: ");
    scanf("%f", &b);

    if (b != 0) {
        result = a / b;
        printf("Division = %.2f\n", result);
    } else {
        printf("Error: Division by zero is not allowed.\n");
    }

    return 0;
}
