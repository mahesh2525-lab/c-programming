#include <stdio.h>
int main()
{
    int n,x,y,rem,sum=0,c=0;
    scanf("%d",&n);
    x=n;
    y=n;

    while(y>0)
    {
        c++;
        y=y/10;
    }

    while(n>0)
    {
        rem=n%10;
        int p=1;
        for(y=1;y<=c;y++)
            p=p*rem;

        sum=sum+p;
        n=n/10;
    }

    if(sum==x)
        printf("Armstrong");
    else
        printf("Not Armstrong");

    return 0;
}
