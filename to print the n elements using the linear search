#include <stdio.h>

int main()
{
    int a[20], i, x, found=0, n=5;

    for(i=0; i<n; i++)
        scanf("%d", &a[i]);

    scanf("%d", &x);

    for(i=0; i<n; i++)
    {
        if(a[i]==x)
        {
            found=1;
            break;
        }
    }

    if(found==1)
        printf("Element found at position %d", i+1);
    else
        printf("Element not found");

    return 0;
}
