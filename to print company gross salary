#include <stdio.h>

int main() {
    float basic, hra, da, gross;

    printf("Enter basic salary: ");
    scanf("%f", &basic);

    hra = basic * 0.20;
    da = basic * 0.10;

    gross = basic + hra + da;

    printf("Basic Salary = %.2f\n", basic);
    printf("HRA = %f\n", hra);
    printf("DA = %f\n", da);
    printf("Gross Salary = %f\n", gross);

    return 0;
}
