#include <stdio.h>

int main()
{
    int a[20], i, x, found=0, n=5;
    int low=0, high=n-1, mid;

    for(i=0; i<n; i++)
        scanf("%d", &a[i]);

    scanf("%d", &x);

    while(low<=high)
    {
        mid=(low+high)/2;

        if(a[mid]==x)
        {
            found=1;
            break;
        }
        else if(x<a[mid])
            high=mid-1;
        else
            low=mid+1;
    }

    if(found==1)
        printf("Element found at position %d", mid+1);
    else
        printf("Element not found");

    return 0;
}
