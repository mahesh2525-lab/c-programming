#include <stdio.h>

void strong(int x)
{
    int n=x, rem, i, f, sum=0;

    while(n>0)
    {
        rem=n%10;
        f=1;

        for(i=1; i<=rem; i++)
            f=f*i;

        sum=sum+f;
        n=n/10;
    }

    if(sum==x)
        printf("Strong Number");
    else
        printf("Not Strong Number");
}

int main()
{
    int x;

    scanf("%d", &x);

    strong(x);

    return 0;
}
